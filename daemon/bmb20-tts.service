[Unit]
Description=MEENA Neural Speech Daemon (Edge-TTS)
After=network.target

[Service]
Type=simple
User=dietpi
WorkingDirectory=/usr/local/bin
ExecStart=/usr/bin/python3 /usr/local/bin/bmb20-tts.py
Restart=always
RestartSec=3
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
